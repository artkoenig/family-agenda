{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver", "docker:pinDigests"],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 1,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "separateMajorMinor": false,
  "packageRules": [
    {
      "description": "typescript-eslint and dependency-cruiser do not support TypeScript 7 yet",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "One PR with every update (all managers, all update types)",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies"
    },
    {
      "description": "Our own image is built by this repository and named by a variable in compose.yaml, not a dependency",
      "matchPackageNames": ["ghcr.io/artkoenig/family-agenda"],
      "enabled": false
    }
  ]
}
