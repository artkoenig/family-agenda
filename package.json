{
  "name": "family-agenda",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise packages apps",
    "test": "vitest run",
    "test:image": "vitest run --config vitest.image.config.ts",
    "eval": "vitest run --config vitest.eval.config.ts",
    "specs": "sh specs/check.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm crap && pnpm mutation",
    "mutation": "stryker run",
    "crap": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json && crap-typescript --exclude .stryker-tmp/** --format text --threshold 8",
    "preview": "node --import tsx tools/preview/src/main.ts",
    "logto-setup": "node --import tsx tools/logto-setup/src/main.ts",
    "openapi": "pnpm --filter @family-agenda/plugin-contract openapi",
    "plugins-schema": "node --import tsx apps/api/src/plugins-file/write-schema.ts",
    "site": "sh site/build.sh"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "2.0.2",
    "@eslint/js": "^10.0.1",
    "@informalsystems/quint": "0.34.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "5.1.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
