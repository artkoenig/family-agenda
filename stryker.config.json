{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "./vitest.stryker.config.ts",
    "related": false
  },
  "mutate": [
    "packages/domain/src/**/*.ts"
  ],
  "timeoutMS": 60000,
  "concurrency": 4,
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 95,
    "low": 75,
    "break": 75
  }
}
