# Settings for compose.yaml. Copy this file to `.env` next to compose.yaml, or load it in the
# variables of a stack tool such as Portainer. A line that starts with # shows the default
# and is not set; remove the # to change it. docs/configuration.md explains each setting.

# Which release to run: a version such as 0.3.1, `latest` for the newest release, `main` for the
# current main branch (no guarantee that it keeps your data). Leave it unset to run the release
# of the compose.yaml you downloaded. Do not copy a version in here: it would outlive an update
# of compose.yaml and keep the old release running.
# FAMILY_AGENDA_VERSION=

# Host port of the Family Agenda web interface.
PORT=8080

# The address the Family opens. Agendas show and copy it. Unset, it is http://<MDNS_NAME>:<PORT>.
# Set it behind your own reverse proxy, such as https://agenda.example.org.
# PUBLIC_URL=

# true behind your own HTTPS reverse proxy, so session cookies become Secure.
TRUST_PROXY=false

# Single sign-on through an OIDC Identity Provider, such as Pocket ID. Leave OIDC_ISSUER_URL unset
# for none. Needs PUBLIC_URL; register <PUBLIC_URL>/sso/callback as the client's redirect URI.
# Only members of OIDC_REQUIRED_GROUP may sign in, and the first of them can create the first Admin.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REQUIRED_GROUP=homelab-admin

# The name the mdns service announces on the home network (Linux host only).
MDNS_NAME=family-agenda.local

# Password of the Postgres user. Postgres keeps the password it was first started with, so
# changing this later does not change the database. Set it before the first start.
# POSTGRES_PASSWORD=family_agenda

# The Family's time zone. It decides where an Agenda's days start.
TZ=Europe/Berlin

# Plugin containers: Source Type id=base URL, comma-separated, such as
# school-portal=http://school-portal:8080. Empty for none.
# PLUGIN_URLS=
