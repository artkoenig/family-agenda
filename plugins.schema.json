{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plugins": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "image": {
            "type": "string",
            "pattern": "^(\\S+@sha256:[a-f0-9]{64}|[^\\s@]*[^\\s@/:]:(?!latest$)\\w[\\w.-]{0,127})$"
          },
          "egress": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*:\\d{1,5}$"
            }
          },
          "limits": {
            "default": {
              "memory": "512m",
              "cpus": 1
            },
            "type": "object",
            "properties": {
              "memory": {
                "default": "512m",
                "type": "string",
                "pattern": "^\\d+[bkmg]$"
              },
              "cpus": {
                "default": 1,
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          "companions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "image": {
                  "type": "string",
                  "pattern": "^(\\S+@sha256:[a-f0-9]{64}|[^\\s@]*[^\\s@/:]:(?!latest$)\\w[\\w.-]{0,127})$"
                },
                "env": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "volumes": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^\\/"
                  }
                },
                "command": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "egress": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*:\\d{1,5}$"
                  }
                },
                "database": {
                  "default": false,
                  "type": "boolean"
                },
                "healthcheck": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "name",
                "image"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "image"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
